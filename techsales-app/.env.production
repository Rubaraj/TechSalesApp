# Production build config — used by `npm run build`, committed on purpose.
#
# `.env.local` carries the same API URL for day-to-day work, but it is
# gitignored: a build on any other machine would fall back to the relative
# `/api` default in src/api/apiBase.ts and aim requests at the static host,
# which serves no API. Hence a committed, mode-specific file.
#
# Nothing secret here. This is the same public gateway URL the browser
# discloses on its first request.
#
# Setting an absolute URL also fixes the training-simulator WebSocket:
# simulatorService.ts derives wss:// from this value rather than from
# window.location, so it correctly reaches the API host and not the page's.

VITE_AI_ENABLED=true
VITE_API_BASE_URL=https://api.rubarajan.dev/techsales/api
