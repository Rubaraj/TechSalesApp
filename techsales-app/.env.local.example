# Frontend env — copy to `.env.local` and customize. .env.local is gitignored.

# Master AI feature flag for the frontend. Combined with the backend's
# `AI_ENABLED` flag (read at login via /api/health) and `getMode()` to gate
# AI UI surfaces. Set to `false` to hide AI features even when the backend
# is willing.
VITE_AI_ENABLED=true
