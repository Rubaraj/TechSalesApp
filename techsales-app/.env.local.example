# Frontend env — copy to `.env.local` and customize. .env.local is gitignored.

# Master AI feature flag for the frontend. Combined with the backend's
# `AI_ENABLED` flag (read at login via /api/health) and `getMode()` to gate
# AI UI surfaces. Set to `false` to hide AI features even when the backend
# is willing.
VITE_AI_ENABLED=true

# ---------------------------------------------------------------------------
# API location — two supported dev modes (see src/api/apiBase.ts):
#
# 1) Pure-local (default, nothing to set): all requests go to same-origin
#    `/api`, and the Vite dev proxy forwards them to a locally-running
#    backend on http://localhost:4000.
#
# 2) Against the Pi-hosted API (shared gateway): point the app straight at
#    the public gateway — the proxy is bypassed entirely.
#      VITE_API_BASE_URL=https://api.rubarajan.dev/techsales/api
#    LIVE CALLS ONLY WORK IN THIS MODE: Twilio's media stream is wired to the
#    Pi, and the live transcript/supervisor buses are in-process — a local
#    backend never receives call audio.
#
# Optionally redirect just the dev proxy target instead (keeps same-origin
# `/api` paths; note the proxy does NOT strip path prefixes):
#      VITE_DEV_PROXY_TARGET=http://localhost:4000
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=
# VITE_DEV_PROXY_TARGET=
