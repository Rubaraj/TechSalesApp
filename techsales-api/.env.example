NODE_ENV=development
PORT=4000

# Mongo: same cluster URI for both DBs; separate dbName per logical database.
# Phase 0 finding (2026-05-02): the replica set's rs.conf() advertises an internal
# hostname that Mongoose's SDAM cannot resolve from a remote client. Using
# directConnection=true bypasses topology discovery and talks to the URI host literally.
# - Mongo on the same host:      mongodb://localhost:27017/?directConnection=true
# - Mongo on another LAN host:   mongodb://<MONGO_HOST>:27017/?directConnection=true
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_APP_DB=medhub_app
MONGO_LOOKUP_DB=medhub_lookup
MONGO_CONNECT_TIMEOUT_MS=3000

# Toggles
FORCE_JSON=false       # if true, skips Mongo entirely and serves from JSON store
JSON_PERSIST=true      # if false, JSON repo is in-memory only

# ----- Data backend (Phase 1 — Databricks migration) -----
# Explicit data-store selector. When set, supersedes FORCE_JSON.
#   mongo       — read/write Mongo (today's default)
#   json        — read/write the bundled JSON store (offline / demo fallback)
#   databricks  — read/write Databricks Delta tables (org deployment)
# Leave unset to fall back to legacy FORCE_JSON behavior.
# DATA_BACKEND=mongo

# Databricks SQL Warehouse (only required when DATA_BACKEND=databricks).
# Example HOST:  https://adb-1234567890123456.7.azuredatabricks.net
# Example HTTP_PATH:  /sql/1.0/warehouses/abc123def456
# TOKEN: a Databricks personal-access token or service-principal token.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=dev_medhub
DATABRICKS_APP_SCHEMA=medhub_app
DATABRICKS_LOOKUP_SCHEMA=medhub_lookup

# CORS — comma-separated origins (e.g., http://localhost:5173), or `*` to
# reflect any origin (safe here: credentials are disabled and no cookies are
# used — production posture on the Pi gateway uses `*` so the frontend can be
# served from localhost, a LAN IP, or a VM without config churn).
CORS_ORIGIN=http://localhost:5173

# Public base URL Twilio uses to reach this API (TwiML webhooks, media-stream
# wss, signature verification). Behind a path-prefixed reverse proxy this is
# the public gateway URL — the /techsales prefix is stripped by Caddy:
# PUBLIC_BASE_URL=https://your-domain.example/techsales
PUBLIC_BASE_URL=

# ----- AI pipeline (Phase 1+) -----
# Master switch — when false, /api/ai/* returns 501 AI_DISABLED.
AI_ENABLED=true

# Phase 7 — LLM provider switch. `ollama` runs everything locally for free
# via qwen2.5:7b (no API key needed). `anthropic` flips the same code path
# to Claude Sonnet/Opus (requires ANTHROPIC_API_KEY + Console credit balance;
# the Max-plan OAuth login does NOT expose a usable backend key).
AI_LLM_PROVIDER=ollama

# Anthropic config (only required when AI_LLM_PROVIDER=anthropic).
# Generate a key at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-4-6
AI_MODEL_PREMIUM=claude-opus-4-7
AI_MAX_DAILY_TOKENS=5000000

# Ollama chat models (used when AI_LLM_PROVIDER=ollama).
# Pull once via:  docker exec ollama ollama pull qwen2.5:7b
# Bump premium to qwen2.5:14b on a GPU box / patient demos.
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_LLM_PREMIUM_MODEL=qwen2.5:7b

# Local services (Docker on the laptop).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_EMBED_MODEL=nomic-embed-text
AI_EMBED_DIM=768

# Agent guardrails.
AI_MAX_TOOL_STEPS=8
AI_REQUEST_TIMEOUT_MS=60000

# Phase 6 — per-user/IP rate limit on /api/ai/* (echo is exempt).
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=300000
