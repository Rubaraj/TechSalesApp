# ---------------------------------------------------------------------------
# techsales-api — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real values.
# Every variable below is declared in src/config/env.ts (zod schema) — that
# file is the source of truth and refuses to boot on invalid config.
#
# Minimum to start with no external services at all:
#   DATA_BACKEND=json
#   MONGO_URI=mongodb://<MONGO_HOST>:27017/?directConnection=true   (unused, but required)
#   AI_ENABLED=false
#   TWILIO_ENABLED=false
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# ----- MongoDB -------------------------------------------------------------
# Same cluster URI for both databases; separate dbName per logical database.
# Replace <MONGO_HOST> with your Mongo host (e.g. `localhost`).
#
# Phase 0 finding (2026-05-02): the replica set's rs.conf() advertises an
# internal hostname that Mongoose's SDAM cannot resolve from a remote client,
# so a `?replicaSet=rs0` URI fails with `getaddrinfo ENOTFOUND`. Using
# directConnection=true talks to the URI host literally and skips topology
# discovery. Trade-off: no transactions, no change streams (neither is used).
#
# NOTE: MONGO_URI is required by the schema even when DATA_BACKEND=json.
MONGO_URI=mongodb://<MONGO_HOST>:27017/?directConnection=true
MONGO_APP_DB=medhub_app
MONGO_LOOKUP_DB=medhub_lookup
MONGO_CONNECT_TIMEOUT_MS=3000

# ----- Legacy toggles ------------------------------------------------------
# Superseded by DATA_BACKEND below; kept for backwards compatibility.
FORCE_JSON=false       # if true, skips Mongo entirely and serves from the JSON store
JSON_PERSIST=true      # if false, the JSON repo is in-memory only

# ----- Data backend --------------------------------------------------------
# Explicit data-store selector. When set, supersedes FORCE_JSON.
#   mongo       — read/write Mongo (default)
#   json        — read/write the bundled JSON store (offline / demo, no deps)
#   databricks  — read/write Databricks Delta tables
# Decided ONCE at boot and locked for the process lifetime — there is no
# per-request fallback. Read it via getDataBackend(), never directly.
# DATA_BACKEND=mongo

# ----- Databricks SQL Warehouse (only when DATA_BACKEND=databricks) --------
# HOST example:       https://adb-1234567890123456.7.azuredatabricks.net
# HTTP_PATH example:  /sql/1.0/warehouses/abc123def456
# TOKEN:              a personal-access or service-principal token. SECRET.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=dev_medhub
DATABRICKS_APP_SCHEMA=medhub_app
DATABRICKS_LOOKUP_SCHEMA=medhub_lookup

# ----- CORS ----------------------------------------------------------------
# Comma-separated origins, or `*` to reflect any origin. `*` is safe here:
# credentials are disabled and no cookies are used.
CORS_ORIGIN=http://localhost:5173

# ----- Public base URL -----------------------------------------------------
# Full public URL Twilio uses to reach this API (TwiML webhooks, media-stream
# wss, signature verification). Required when TWILIO_ENABLED=true.
# Behind a path-prefixed reverse proxy, include the prefix:
#   PUBLIC_BASE_URL=https://your-domain.example/techsales
PUBLIC_BASE_URL=

# ----- AI pipeline ---------------------------------------------------------
# Master switch — when false, /api/ai/* returns 501 AI_DISABLED.
AI_ENABLED=true

# Atlas agentic copilot switch — when false, /api/ai/atlas/* returns 501
# ATLAS_DISABLED. Independent of AI_ENABLED, so member-facing chat can stay
# on while the internal copilot is turned off.
ATLAS_ENABLED=true

# LLM provider switch. `ollama` runs everything locally for free via
# qwen2.5:7b (no API key). `anthropic` flips the same code path to Claude.
# `stub` returns canned responses (useful for tests).
AI_LLM_PROVIDER=ollama

# Anthropic config (only required when AI_LLM_PROVIDER=anthropic). SECRET.
# Generate a key at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
# Optional override to point the Anthropic client at a compatible gateway
# (e.g. OpenRouter's Anthropic-compatible passthrough). Leave unset for
# api.anthropic.com.
ANTHROPIC_BASE_URL=

AI_MODEL_DEFAULT=claude-sonnet-4-6
AI_MODEL_PREMIUM=claude-opus-4-7
# Model for on-demand call QA reviews. Empty → falls back to AI_MODEL_DEFAULT.
AI_MODEL_QA=
AI_MAX_DAILY_TOKENS=5000000
AI_MAX_DAILY_TOKENS_PER_USER=100000

# Ollama chat models (used when AI_LLM_PROVIDER=ollama).
# Pull once via:  docker exec ollama ollama pull qwen2.5:7b
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_LLM_PREMIUM_MODEL=qwen2.5:7b

# ----- Vector search + embeddings ------------------------------------------
# Qdrant backs plan search. The BM25 half of hybrid retrieval is built by
# scrolling payloads out of Qdrant, so an unreachable Qdrant disables BOTH
# halves of search and only logs a warning.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_EMBED_MODEL=nomic-embed-text
AI_EMBED_DIM=768

# ----- Agent guardrails ----------------------------------------------------
AI_MAX_TOOL_STEPS=8
AI_REQUEST_TIMEOUT_MS=60000

# Per-user/IP rate limit on /api/ai/* (the echo endpoint is exempt).
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=300000

# ----- Twilio (live call copilot) ------------------------------------------
# Master switch. When false, /api/ai/call/* returns 501 and Twilio webhooks
# refuse to serve TwiML.
#
# When TWILIO_ENABLED=true the boot asserts ALL of these are set:
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_API_KEY_SID,
#   TWILIO_API_KEY_SECRET, TWILIO_TWIML_APP_SID, TWILIO_OUTBOUND_CALLER_ID,
#   DEEPGRAM_API_KEY, PUBLIC_BASE_URL
# Missing any one of them exits the process with a clear message.
TWILIO_ENABLED=false

# All values below are SECRET — from console.twilio.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# E.164 caller id you own, e.g. +15550100
TWILIO_OUTBOUND_CALLER_ID=

# Hard cap on one call's duration (TwiML Dial timeLimit + a server-side
# timer). Stops a stuck call from burning Twilio + Deepgram budget.
TWILIO_MAX_CALL_DURATION_SECONDS=1800
TWILIO_MAX_DAILY_CALL_MINUTES_PER_USER=240

# Dev-only escape hatch for X-Twilio-Signature verification. Asserted OFF
# when NODE_ENV=production — a prod boot with this true exits.
TWILIO_SKIP_VERIFY=false

# ----- Deepgram (transcription + voice agents) -----------------------------
# SECRET — from console.deepgram.com.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# ----- Training simulator (Deepgram Voice Agent) ---------------------------
# The prospect persona's "think" LLM runs inside Deepgram's cloud, NOT via
# AI_LLM_PROVIDER — so the simulator keeps working when the app's own LLM
# provider is down. An off-list model id is rejected by Deepgram at session
# setup, not by this app. Verified accepted (2026-07): claude-haiku-4-5,
# claude-sonnet-4-5, claude-sonnet-4-6, claude-sonnet-5.
SIMULATOR_ENABLED=true
SIMULATOR_THINK_MODEL=claude-haiku-4-5
SIMULATOR_MAX_SESSION_SECONDS=600

# ----- AI call screening ---------------------------------------------------
# The Voice Agent answers inbound calls on the agent's behalf until takeover.
SCREENING_ENABLED=true
# Publish the Voice Agent's own transcript of its speech as 'agent' chunks.
# Default off — the media-stream fork already captures the AI voice.
SCREENING_PUBLISH_BOT_TRANSCRIPTS=false
# Kill switch for the screening assistant's function calling. Off → it still
# screens, just without lookups or structured capture.
SCREENING_TOOLS_ENABLED=true
# Auto-answer calls nobody picked up, and calls arriving with no agent online.
SCREENING_AUTO_ENABLED=true
# Identity used when NO agent is online — drives greeting name, persona,
# tool data scope, and auto-lead ownership.
SCREENING_FALLBACK_USER_ID=USER-004

# ----- Logging -------------------------------------------------------------
# Read directly in src/config/logger.ts. trace|debug|info|warn|error|fatal
LOG_LEVEL=info
